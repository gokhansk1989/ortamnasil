# OrtamNasıl? — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve değerleri doldur

# === ZORUNLU ===

# PostgreSQL bağlantı adresi
DATABASE_URL="postgresql://ortamnasil_user:SIFRE@localhost:5432/ortamnasil"

# E-posta hash'leme pepper'ı — DEĞİŞTİRME, mevcut kullanıcı girişleri bozulur
AUTH_PEPPER="ortamnasil_pepper_2024_secret"

# Oturum ve admin cookie imzalama anahtarı
SESSION_SECRET=""

# Resend API anahtarı (e-posta gönderimi)
RESEND_API_KEY=""

# Admin e-posta adresi (OTP gönderimi)
ADMIN_EMAIL="gokhansk1989@gmail.com"

# Cron job doğrulama anahtarı
CRON_SECRET=""

# === ANALİTİK (opsiyonel) ===

# Google Analytics 4 ölçüm ID'si
NEXT_PUBLIC_GA_ID=""

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""

# === PUSH NOTIFICATION (opsiyonel) ===

# VAPID anahtarları (web-push generate-vapid-keys ile oluşturulur)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# === ARAMA MOTORU DOĞRULAMA (opsiyonel) ===

# Google Search Console doğrulama kodu
GOOGLE_SITE_VERIFICATION=""

# Bing Webmaster Tools doğrulama kodu
BING_SITE_VERIFICATION=""
